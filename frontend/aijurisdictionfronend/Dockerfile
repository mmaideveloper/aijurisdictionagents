FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_AUTH_GOOGLE_START_URL=
ARG VITE_AUTH_X_START_URL=
ARG VITE_API_BASE_URL=https://api.jurisdigta.eu
ARG VITE_API_KEY=aijuris
ARG VITE_API_COUNTRY=SK
ARG VITE_API_LANGUAGE=en
ARG VITE_CHAT_MODEL_LABEL="Azure Foundry model"
ARG VITE_AIJ_SPEECHTYPE=message

ENV VITE_AUTH_GOOGLE_START_URL=$VITE_AUTH_GOOGLE_START_URL
ENV VITE_AUTH_X_START_URL=$VITE_AUTH_X_START_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_API_COUNTRY=$VITE_API_COUNTRY
ENV VITE_API_LANGUAGE=$VITE_API_LANGUAGE
ENV VITE_CHAT_MODEL_LABEL=$VITE_CHAT_MODEL_LABEL
ENV VITE_AIJ_SPEECHTYPE=$VITE_AIJ_SPEECHTYPE

COPY package*.json ./
RUN npm ci

COPY . ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

    classDef external fill:#E5E7EB,color:#111827,stroke:#6B7280
    classDef person fill:#DBEAFE,color:#111827,stroke:#2F6FAB
    class title title
    class api focal
    class web,mobile,docjob,lawsjob,emailjob,db,blobs,telemetry owned

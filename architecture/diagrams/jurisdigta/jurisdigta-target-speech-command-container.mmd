flowchart LR
  title["JurisDigta target containers — governed speech questions and commands<br/><small>Conceptual target; approved ADD-001 / accepted ADR-001</small>"]

  user["JurisDigta user<br/><small>Reviews transcript and authorizes actions</small>"]
  reviewer["Human reviewer<br/><small>Reviews legal-risk outcomes</small>"]

  subgraph device["User browser/device trust boundary"]
    client["agent.jurisdigta.eu web client<br/><small>React; transcript, preview, confirmation</small>"]
    stt["Speech recognition adapter<br/><small>Device/browser or disclosed remote mode</small>"]
    local["Browser directory-search capability<br/><small>Proposed; session-only filename/metadata search</small>"]
  end

  subgraph platform["JurisDigta controlled platform boundary"]
    intake["Request intake and intent router<br/><small>Proposal only; structured slots</small>"]
    chat["Question and legal workflow path<br/><small>Existing chat/case behavior</small>"]
    catalog["Capability catalog<br/><small>Proposed versioned policy metadata</small>"]
    policy["Policy and authorization gateway<br/><small>Proposed deny-by-default execution boundary</small>"]
    executor["Capability execution orchestrator<br/><small>Proposed idempotency, timeout, cancellation</small>"]
    tools["Server capability adapters<br/><small>Existing tools evolved behind gateway</small>"]
    audit[("Case, authorization, and audit stores<br/><small>Existing stores plus proposed records</small>")]
  end

  remoteStt["Remote STT provider<br/><small>External; only after applicable consent</small>"]
  orsr["Official ORSR service<br/><small>External public business registry</small>"]

  user -->|"Speaks and reviews text [potential personal/legal data]"| client
  reviewer -->|"Reviews legal-risk output [authorized case access]"| client
  client -->|"Active audio segment and locale [transient]"| stt
  stt -.->|"Optional disclosed remote recognition [audio; consent required]"| remoteStt
  stt -->|"Transcript and recognition metadata"| client
  client -->|"Reviewed text, context, correlation/idempotency key [HTTPS API]"| intake
  intake -->|"Question and case context [existing internal interface]"| chat
  chat -->|"Answer and review state"| client
  intake -->|"Candidate intent and capability traits [interface to define]"| catalog
  catalog -->|"Eligible capability versions and policy metadata"| intake
  intake -->|"Execution proposal and required authorization"| client
  client -->|"Selected proposal, confirmation, and scope grant [HTTPS API; schema to define]"| policy
  policy -->|"Validate identity, consent, scope, risk, versions"| catalog
  policy -->|"Record authorization/denial metadata [redacted]"| audit
  policy -->|"Immutable authorized capability request"| executor
  executor -->|"Registered server operation and minimum slots"| tools
  tools -->|"Company query [HTTPS; current integration]"| orsr
  orsr -->|"Sourced match/result"| tools
  client -.->|"After gateway authorization: search user-selected folder [browser API]"| local
  local -.->|"Minimal filename/metadata result; no content read/upload"| client
  executor -->|"Execution status, provenance, related capability suggestions"| client
  executor -->|"Record outcome, versions, timing [redacted]"| audit


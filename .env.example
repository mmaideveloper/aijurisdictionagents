# LLM_PROVIDER options: azurefoundry | openai | mock
LLM_PROVIDER=azurefoundry
SYSTEM_EMBEDDING_MODEL_OPTION=local
SYSTEM_EMBEDDING_MODEL=all-MiniLM-L6-v2
SYSTEM_EMBEDDING_DEVICE=auto

# OpenAI
# OPENAI_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
# OPENAI_TEMPERATURE=0.2

# Azure Foundry (Azure OpenAI)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# For Azure embeddings this must be the deployed embedding deployment name.
# If you deploy with the default model name, use text-embedding-3-large.
# AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_AD_TOKEN=optional_aad_token
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# OPENAI_API_VERSION=2024-12-01-preview

# GitHub Project automation
# GH_PROJECT_TOKEN=ghp_xxx
# Codex Desktop setup also recognizes GH_TOKEN/GITHUB_TOKEN in local .env files.
# Keep real tokens out of git and rotate any token exposed in screenshots or logs.
# GH_TOKEN=github_pat_xxx

# Frontend Vite runtime (frontend/aijurisdictionfronend)
# VITE_API_BASE_URL=https://api-juris-dev.victoriousdesert-e45eec11.westeurope.azurecontainerapps.io
# VITE_API_KEY=aijuris
# VITE_API_COUNTRY=SK
# VITE_API_LANGUAGE=en

# Shared API endpoint override for local scripts/examples
# AIJ_API_BASE_URL=https://api-juris-dev.victoriousdesert-e45eec11.westeurope.azurecontainerapps.io

# Vehicle validation API (optional, used by slovakia_car_validate tool)
# CAR_VALIDATION_API_BASE_URL=https://www.databazavozidiel.sk
# CAR_VALIDATION_API_KEY=your_vehicle_checks_api_key

# Mobile Android release signing for CI/GitHub Release APKs.
# Use one stable keystore for every published mobile release so Android in-app
# upgrades keep the same package signature across versions.
# MOBILE_ANDROID_KEYSTORE_BASE64=$(base64 -w 0 path/to/release.keystore)
# MOBILE_ANDROID_KEYSTORE_PASSWORD=changeit
# MOBILE_ANDROID_KEY_ALIAS=release
# MOBILE_ANDROID_KEY_PASSWORD=changeit

# Mobile app speech runtime
# AIJ_SPEECH_MODE options: local | azure
# AIJ_SPEECH_MODE=local
# AIJ_SPEECHTYPE options: message | conversation
# message is the privacy-first default: STT fills a reviewed message draft before send.
# conversation preserves the older continuous speech session with silence confirmation.
# AIJ_SPEECHTYPE=message
# Azure speech mode requires AIJ_AZURE_SPEECH_KEY and either AIJ_AZURE_SPEECH_REGION
# or the explicit TTS/STT endpoints below.
# AIJ_AZURE_SPEECH_KEY=your_speech_key
# AIJ_AZURE_SPEECH_REGION=westeurope
# Backward-compatible TTS endpoint:
# AIJ_AZURE_SPEECH_ENDPOINT=https://westeurope.tts.speech.microsoft.com/cognitiveservices/v1
# Preferred split endpoints:
# AIJ_AZURE_SPEECH_TTS_ENDPOINT=https://westeurope.tts.speech.microsoft.com
# AIJ_AZURE_SPEECH_STT_ENDPOINT=https://westeurope.stt.speech.microsoft.com
# Local speech model hints (mobile/web local-first profile):
# AIJ_LOCAL_STT_MODEL=whisper-small-multilingual
# AIJ_LOCAL_TTS_MODEL=piper-sk_SK-katarina-medium

# API deployment workflow (Azure)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_LOCATION=westeurope
# AZURE_DOCUMENT_PROCESSOR_LOCATION=westeurope
# AZURE_DOCUMENT_PROCESSOR_CRON_EXPRESSION=*/15 * * * *
# DOCUMENT_PROCESSOR_MAX_RUNNING_TIME=60
# AZURE_RESOURCE_GROUP=
# AZURE_CONTAINERAPPS_ENVIRONMENT=
# AZURE_CONTAINER_APP_NAME=
# AZURE_LAWS_COLLECTOR_CONTAINER_APP_NAME=laws-collector
# AZURE_LAWS_COLLECTOR_CRON_EXPRESSION=0 0 * * *
# AZURE_LAWS_COLLECTOR_MAX_PROBES=1
# AZURE_LAWS_STORAGE_CONTAINER_NAME=laws-collection-sk
# LAWS_COLLECTOR_MAX_RUNNING_TIME=60
# AZURE_POSTGRES_SERVER_NAME=db-juris-dev
# AZURE_POSTGRES_DATABASE_NAME=aijurisdiction
# AZURE_LAWS_POSTGRES_DATABASE_NAME_SK=laws_sk
# AZURE_POSTGRES_ADMIN_USERNAME=jurisadmin
# AZURE_POSTGRES_ADMIN_PASSWORD=
# AZURE_POSTGRES_SKU_NAME=Standard_B1ms
# AZURE_POSTGRES_SKU_TIER=Burstable
# AZURE_POSTGRES_VERSION=16
# AZURE_POSTGRES_STORAGE_SIZE_GB=32
# AZURE_CONTAINER_REGISTRY=
# AZURE_LOG_ANALYTICS_WORKSPACE_NAME=log-aijurisdiction-dev
# AZURE_APPLICATION_INSIGHTS_NAME=ai-juris-dev
# AZURE_MANAGED_IDENTITY_NAME=id-aijurisdiction-api-dev
# Deployed Azure runtimes should normally keep cloud embeddings:
# SYSTEM_EMBEDDING_MODEL_OPTION=cloud
# SYSTEM_EMBEDDING_MODEL=all-MiniLM-L6-v2
# SYSTEM_EMBEDDING_DEVICE=auto
# AZURE_API_IMAGE_TAG supports either:
# - tag only (example: latest)
# - repository:tag (example: ai-api-juris-dev:latest)
# AZURE_API_IMAGE_TAG=

# Azure Monitor / Application Insights for API telemetry (recommended for ACA)
# Store the production connection string as a secret in GitHub Environment or Container Apps secret.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
# The observability logs endpoint reuses:
# AZURE_LOG_ANALYTICS_WORKSPACE_NAME
# AZURE_MANAGED_IDENTITY_NAME
# OTEL_SERVICE_NAME=aijuristiction-api
# OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0
# OTEL_TRACES_SAMPLER=microsoft.rate_limited
# OTEL_TRACES_SAMPLER_ARG=5
# Optional non-Azure fallback exporter:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces


## API database/storage selection (local|postgres|azure)
DB_OPTION=local
STORAGE_OPTION=local
# Local auth test helper. Keep disabled outside local development.
# The local API launcher enables this automatically for 127.0.0.1/localhost starts.
LOCAL_AUTH_ACCEPT_ANY_CODE=0
# Secret used to sign MCP JWT bearer tokens. Set a long random value in deployed environments.
# MCP_API_JWT_SECRET=change-this-long-random-secret
# Optional override for flow-pack runtime SQLite storage.
# API_FLOW_PACKS_SQLITE_PATH=./runs/storage/api/sqlite/flow_packs.sqlite3
# DOCUMENT_PROCESSOR_OPTION options:
# - local: process uploaded case documents immediately inside the API
# - azure: leave uploads pending for the Azure Container Apps document processor job
DOCUMENT_PROCESSOR_OPTION=local

# Email notifications
# Use EMAIL_TRANSPORT=log for local queue-only testing, or smtp to send via the configured mailbox.
# Azure API deployment reads these values from GitHub Environment variables/secrets.
# If you deploy a dedicated Azure email scheduler ACA Job, set EMAIL_SCHEDULER_ENABLED=false on the API app.
# AZURE_EMAIL_SCHEDULER_JOB_NAME=email-scheduler
# AZURE_EMAIL_SCHEDULER_CRON_EXPRESSION=*/5 * * * *
EMAIL_TRANSPORT=log
EMAIL_SENDER=no-reply@jurisdigta.eu
EMAIL_SMTP_HOST=mail.webhouse.sk
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USERNAME=no-reply@jurisdigta.eu
# EMAIL_SMTP_PASSWORD=your_mailbox_password_here

# Corporate web contact anti-spam protection (Cloudflare Turnstile).
# In deployed environments, set CONTACT_CAPTCHA_REQUIRED=true on the API and configure
# TURNSTILE_SECRET_KEY as an API secret. The corporate web deploy injects TURNSTILE_SITE_KEY
# into the static page from the selected GitHub Environment variable.
# CORPORATE_WEB_API_BASE_URL=https://api.jurisdigta.eu
# CONTACT_CAPTCHA_REQUIRED=true
# TURNSTILE_SITE_KEY=0x4AAAAAA_your_public_site_key
# TURNSTILE_SECRET_KEY=0x4AAAAAA_your_private_secret_key
# CONTACT_RATE_LIMIT_MAX_REQUESTS=5
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=600

# Local mode
DB_LOCAL=./runs/storage/api/sqlite/api.sqlite3
STORE_LOCAL=./runs/storage/api/files

# Local PostgreSQL Docker defaults (see skills/start-postgres/scripts/start_postgres.ps1)
# LOCAL_POSTGRES_DB=aijurisdiction
# LOCAL_POSTGRES_USER=postgres
# LOCAL_POSTGRES_PASSWORD=postgres
# LOCAL_POSTGRES_PORT=5432
# Example local PostgreSQL DB_CLOUD:
# DB_CLOUD=postgresql://postgres:postgres@127.0.0.1:5432/aijurisdiction

# Azure mode (set in GitHub environment secrets)
# Azure PostgreSQL Flexible Server uses the configured administrator login as-is.
# DB_CLOUD=postgresql://jurisadmin:<password>@db-juris-dev.postgres.database.azure.com:5432/aijurisdiction?sslmode=require
# STORE_CLOUD=https://<storage-account>.blob.core.windows.net/<container-name>
# Set this only for deployed browser clients (for example Flutter web hosted outside ACA).
# Native Android/iOS builds do not need CORS_ALLOW_ORIGINS.
# CORS_ALLOW_ORIGINS=https://mobile-web-dev.example.com,https://web-juris-dev.<region>.azurecontainerapps.io

# Laws collector
# Selects the country-specific collector implementation. Only SK is implemented today.
# LAWS_COUNTRY=SK
LAWS_COLLECTOR_IMPORT=zip
LAWS_COLLECTOR_IMPORT_ZIP_MAX_THREADS=10
# `zip` is the default Slovak import path:
# - first bootstrap from the full Slov-Lex archive under `./archivelaws/laws-collection-sk`
# - then continue from monthly `exportZmeny.zip` deltas with resume support
# Set `one_law_url` to keep the older sequential per-law probe importer.
LAWS_DB_BACKEND=sqlite
# SQLite default stays `sk_laws.sqlite3` for Slovakia. Future countries default to `<country>_laws.sqlite3`.
LAWS_DB_LOCAL=./runs/storage/laws-collector/sqlite/sk_laws.sqlite3
LAWS_DELTA_POLL_HOURS=3
# `zip` mode persists archive/monthly import cursors in the laws database and downloads Slov-Lex bundles into `./archivelaws/laws-collection-sk`.
# `one_law_url` keeps the older sequential probe state in `collector_progress` starting from law `1/1945`.
# Worker options:
# LAWS_WORKER_FIXTURE=live   # baseline | delta | live
# LAWS_WORKER_POLL_SECONDS=3600
# LAWS_WORKER_MAX_CYCLES=0
# LAWS_WORKER_MAX_PROBES=1   # Worker fallback; the local laws-collector skill defaults to 1000 for production-style starts.
# LAWS_COLLECTOR_MAX_RUNNING_TIME=60  # minutes; set 0 for unlimited
# LAWS_COLLECTOR_FORCE_ZIP_REFRESH=0  # Set 1 only for explicit archive/monthly ZIP repair or bootstrap refresh.
# Optional manual override for the model knowledge cutoff shown by `/version`.
# When unset, the API resolves the cutoff from the current LLM model via
# `AIWebSearchAgent`, stores it in `permanent_memory.key=llm_model_setup`, and
# optionally mirrors it to the local cache file below.
# MODEL_KNOWLEDGE_CUTOFF_DATE=2020-12-31
# MODEL_KNOWLEDGE_CUTOFF_CACHE_FILE=./runs/storage/api/cache/model_knowledge_cutoff_cache.json
# Reserved for future export/cache flows; the current implementation stores documents in DB.
# Storage defaults to `./runs/storage/laws-collector/files/<country>` when unset.
# LAWS_STORAGE_LOCAL=./runs/storage/laws-collector/files/sk
# Future cloud settings
# PostgreSQL database naming is `laws_sk` for Slovakia and `laws_<country>` for future countries.
# LAWS_DB_CLOUD=postgresql://user:password@host:5432/laws_sk
# For Azure laws collector jobs, this can be omitted and the deploy will derive:
# https://<AZURE_STORAGE_ACCOUNT_NAME>.blob.core.windows.net/laws-collection-sk
# unless you explicitly override `AZURE_LAWS_STORAGE_CONTAINER_NAME`.
# LAWS_STORAGE_CLOUD=https://<storage-account>.blob.core.windows.net/laws-collection-sk

# Server/system monitoring status JSON read by GET /v1/system/status.
# On jurisdigta-server, scripts/server/write_system_status.py writes this file every minute.
SYSTEM_STATUS_FILE=./runs/status/system-status.json

# Optional Prometheus/Grafana monitoring on jurisdigta-server.
# The exporter converts GET /v1/system/status to Prometheus text metrics.
JURISDIGTA_METRICS_HOST=127.0.0.1
JURISDIGTA_METRICS_PORT=9108
JURISDIGTA_STATUS_URL=http://127.0.0.1:8080/v1/system/status?minutes=60
# JURISDIGTA_API_KEY=aijuris
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=replace-with-long-random-password
# GRAFANA_SMTP_ENABLED=true
# GRAFANA_SMTP_HOST=mail.webhouse.sk:587
# GRAFANA_SMTP_USER=no-reply@jurisdigta.eu
# GRAFANA_SMTP_PASSWORD=your_mailbox_password_here
# GRAFANA_SMTP_FROM_ADDRESS=no-reply@jurisdigta.eu
# GRAFANA_SMTP_FROM_NAME=JurisDigta Grafana
# GRAFANA_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
# GRAFANA_ALERT_EMAIL_TO=admin@example.com

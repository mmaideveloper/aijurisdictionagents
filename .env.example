# LLM_PROVIDER options: azurefoundry | openai | mock
LLM_PROVIDER=azurefoundry

# OpenAI
# OPENAI_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2

# Azure Foundry (Azure OpenAI)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_AD_TOKEN=optional_aad_token
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# OPENAI_API_VERSION=2024-12-01-preview

# GitHub Project automation
# GH_PROJECT_TOKEN=ghp_xxx

# API deployment workflow (Azure)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_LOCATION=austriaeast
# AZURE_RESOURCE_GROUP=
# AZURE_CONTAINERAPPS_ENVIRONMENT=
# AZURE_CONTAINER_APP_NAME=
# AZURE_POSTGRES_SERVER_NAME=db-juris-dev
# AZURE_POSTGRES_DATABASE_NAME=aijurisdiction
# AZURE_POSTGRES_ADMIN_USERNAME=jurisadmin
# AZURE_POSTGRES_ADMIN_PASSWORD=
# AZURE_POSTGRES_SKU_NAME=Standard_B1ms
# AZURE_POSTGRES_SKU_TIER=Burstable
# AZURE_POSTGRES_VERSION=16
# AZURE_POSTGRES_STORAGE_SIZE_GB=32
# AZURE_CONTAINER_REGISTRY=
# AZURE_LOG_ANALYTICS_WORKSPACE_NAME=log-aijurisdiction-dev
# AZURE_MANAGED_IDENTITY_NAME=id-aijurisdiction-api-dev
# AZURE_API_IMAGE_TAG supports either:
# - tag only (example: latest)
# - repository:tag (example: ai-api-juris-dev:latest)
# AZURE_API_IMAGE_TAG=


## API database/storage selection (local|postgres|azure)
DB_OPTION=local
STORAGE_OPTION=local

# Local mode
DB_LOCAL=./databases/api.sqlite3
STORE_LOCAL=./storage

# Local PostgreSQL Docker defaults (see databases/docker-compose.yml)
# LOCAL_POSTGRES_DB=aijurisdiction
# LOCAL_POSTGRES_USER=postgres
# LOCAL_POSTGRES_PASSWORD=postgres
# LOCAL_POSTGRES_PORT=5432
# Example local PostgreSQL DB_CLOUD:
# DB_CLOUD=postgresql://postgres:postgres@127.0.0.1:5432/aijurisdiction

# Azure mode (set in GitHub environment secrets)
# DB_CLOUD=postgresql://jurisadmin:<password>@db-juris-dev.postgres.database.azure.com:5432/aijurisdiction?sslmode=require
# STORE_CLOUD=https://<storage-account>.blob.core.windows.net/<container-name>

# Slovak laws collector
LAWS_COUNTRY=SK
LAWS_DB_BACKEND=sqlite
LAWS_DB_LOCAL=./databases/laws-collector/sk_laws.sqlite3
LAWS_DELTA_POLL_HOURS=3
# Reserved for future export/cache flows; the current implementation stores documents in DB
# LAWS_STORAGE_LOCAL=./storage/laws/sk
# Future cloud settings
# LAWS_DB_CLOUD=postgresql://user:password@host:5432/laws
# LAWS_STORAGE_CLOUD=https://<storage-account>.blob.core.windows.net/law-corpus

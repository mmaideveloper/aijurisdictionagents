# LLM_PROVIDER options: azurefoundry | openai | mock
LLM_PROVIDER=azurefoundry

# OpenAI
# OPENAI_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
# OPENAI_TEMPERATURE=0.2

# Azure Foundry (Azure OpenAI)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# For Azure embeddings this must be the deployed embedding deployment name.
# If you deploy with the default model name, use text-embedding-3-large.
# AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_AD_TOKEN=optional_aad_token
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# OPENAI_API_VERSION=2024-12-01-preview

# GitHub Project automation
# GH_PROJECT_TOKEN=ghp_xxx

# Mobile Android release signing for CI/GitHub Release APKs.
# Use one stable keystore for every published mobile release so Android in-app
# upgrades keep the same package signature across versions.
# MOBILE_ANDROID_KEYSTORE_BASE64=$(base64 -w 0 path/to/release.keystore)
# MOBILE_ANDROID_KEYSTORE_PASSWORD=changeit
# MOBILE_ANDROID_KEY_ALIAS=release
# MOBILE_ANDROID_KEY_PASSWORD=changeit

# Mobile app speech runtime
# AIJ_SPEECH_MODE options: local | azure
# AIJ_SPEECH_MODE=local
# Azure speech mode requires AIJ_AZURE_SPEECH_KEY and either AIJ_AZURE_SPEECH_REGION
# or the explicit TTS/STT endpoints below.
# AIJ_AZURE_SPEECH_KEY=your_speech_key
# AIJ_AZURE_SPEECH_REGION=westeurope
# Backward-compatible TTS endpoint:
# AIJ_AZURE_SPEECH_ENDPOINT=https://westeurope.tts.speech.microsoft.com/cognitiveservices/v1
# Preferred split endpoints:
# AIJ_AZURE_SPEECH_TTS_ENDPOINT=https://westeurope.tts.speech.microsoft.com
# AIJ_AZURE_SPEECH_STT_ENDPOINT=https://westeurope.stt.speech.microsoft.com

# API deployment workflow (Azure)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_LOCATION=westeurope
# AZURE_RESOURCE_GROUP=
# AZURE_CONTAINERAPPS_ENVIRONMENT=
# AZURE_CONTAINER_APP_NAME=
# AZURE_LAWS_COLLECTOR_CONTAINER_APP_NAME=laws-collector
# AZURE_POSTGRES_SERVER_NAME=db-juris-dev
# AZURE_POSTGRES_DATABASE_NAME=aijurisdiction
# AZURE_LAWS_POSTGRES_DATABASE_NAME_SK=laws_sk
# AZURE_POSTGRES_ADMIN_USERNAME=jurisadmin
# AZURE_POSTGRES_ADMIN_PASSWORD=
# AZURE_POSTGRES_SKU_NAME=Standard_B1ms
# AZURE_POSTGRES_SKU_TIER=Burstable
# AZURE_POSTGRES_VERSION=16
# AZURE_POSTGRES_STORAGE_SIZE_GB=32
# AZURE_CONTAINER_REGISTRY=
# AZURE_LOG_ANALYTICS_WORKSPACE_NAME=log-aijurisdiction-dev
# AZURE_APPLICATION_INSIGHTS_NAME=ai-juris-dev
# AZURE_MANAGED_IDENTITY_NAME=id-aijurisdiction-api-dev
# AZURE_API_IMAGE_TAG supports either:
# - tag only (example: latest)
# - repository:tag (example: ai-api-juris-dev:latest)
# AZURE_API_IMAGE_TAG=

# Azure Monitor / Application Insights for API telemetry (recommended for ACA)
# Store the production connection string as a secret in GitHub Environment or Container Apps secret.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
# OTEL_SERVICE_NAME=aijuristiction-api
# OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0
# OTEL_TRACES_SAMPLER=microsoft.rate_limited
# OTEL_TRACES_SAMPLER_ARG=5
# Optional non-Azure fallback exporter:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces


## API database/storage selection (local|postgres|azure)
DB_OPTION=local
STORAGE_OPTION=local
# DOCUMENT_PROCESSOR_OPTION options:
# - local: process uploaded case documents immediately inside the API
# - azure: leave uploads pending for the Azure Container Apps document processor job
DOCUMENT_PROCESSOR_OPTION=local

# Local mode
DB_LOCAL=./databases/api.sqlite3
STORE_LOCAL=./storage

# Local PostgreSQL Docker defaults (see databases/docker-compose.yml)
# LOCAL_POSTGRES_DB=aijurisdiction
# LOCAL_POSTGRES_USER=postgres
# LOCAL_POSTGRES_PASSWORD=postgres
# LOCAL_POSTGRES_PORT=5432
# Example local PostgreSQL DB_CLOUD:
# DB_CLOUD=postgresql://postgres:postgres@127.0.0.1:5432/aijurisdiction

# Azure mode (set in GitHub environment secrets)
# Azure PostgreSQL Flexible Server uses the configured administrator login as-is.
# DB_CLOUD=postgresql://jurisadmin:<password>@db-juris-dev.postgres.database.azure.com:5432/aijurisdiction?sslmode=require
# STORE_CLOUD=https://<storage-account>.blob.core.windows.net/<container-name>
# Set this only for deployed browser clients (for example Flutter web hosted outside ACA).
# Native Android/iOS builds do not need CORS_ALLOW_ORIGINS.
# CORS_ALLOW_ORIGINS=https://mobile-web-dev.example.com,https://web-juris-dev.<region>.azurecontainerapps.io

# Laws collector
# Selects the country-specific collector implementation. Only SK is implemented today.
# LAWS_COUNTRY=SK
LAWS_DB_BACKEND=sqlite
# SQLite default stays `sk_laws.sqlite3` for Slovakia. Future countries default to `<country>_laws.sqlite3`.
LAWS_DB_LOCAL=./databases/laws-collector/sk_laws.sqlite3
LAWS_DELTA_POLL_HOURS=3
# Slovak Slov-Lex sequential import always starts at law `1/1993`.
# Progress is persisted in the laws database, including:
# - last collector run timestamp
# - last processed law (for example `234/2026`)
# - next law number/year probe target
# Worker options:
# LAWS_WORKER_FIXTURE=live   # baseline | delta | live
# LAWS_WORKER_POLL_SECONDS=3600
# LAWS_WORKER_MAX_CYCLES=0
# Optional fallback when the laws database has no imported records yet.
# Provider APIs do not expose a reliable legal knowledge cutoff automatically,
# so set this manually to the model/legal corpus cutoff you want the system to
# show on first startup. The API caches it once and keeps using that cached
# value until the laws database starts returning real import timestamps.
# MODEL_KNOWLEDGE_CUTOFF_DATE=2020-12-31
# MODEL_KNOWLEDGE_CUTOFF_CACHE_FILE=./databases/model_knowledge_cutoff_cache.json
# Reserved for future export/cache flows; the current implementation stores documents in DB.
# Storage defaults to `./storage/laws/<country>` when unset.
# LAWS_STORAGE_LOCAL=./storage/laws/sk
# Future cloud settings
# PostgreSQL database naming is `laws_sk` for Slovakia and `laws_<country>` for future countries.
# LAWS_DB_CLOUD=postgresql://user:password@host:5432/laws_sk
# LAWS_STORAGE_CLOUD=https://<storage-account>.blob.core.windows.net/law-corpus
